{
  "product": "HEAVENLY KEY BIBLE",
  "worker": "heavenly-key-bible",
  "config": "apps/heavenly-key-bible/bible/wrangler.toml",
  "qualityWorkflow": ".github/workflows/deploy-bible.yml",
  "releaseMode": "dedicated-account6-github-push",
  "autoUpdate": true,
  "autoUpdateBranch": "main",
  "watchedPaths": [
    "apps/heavenly-key-bible/**",
    ".github/workflows/deploy-bible.yml"
  ],
  "preDeployChecks": [
    "scripture",
    "reader",
    "offline",
    "worker",
    "assets",
    "study-tools",
    "live"
  ],
  "isolation": {
    "dedicatedCloudflareAccount": true,
    "sharedDatabaseMutation": false,
    "forwardPrivateCredentials": false
  },
  "requirements": {
    "dedicatedCloudflareToken": "BIBLE_CLOUDFLARE_API_TOKEN",
    "dedicatedCloudflareAccountId": "BIBLE_CLOUDFLARE_ACCOUNT_ID",
    "liveUrlVariable": "BIBLE_LIVE_URL"
  }
}
