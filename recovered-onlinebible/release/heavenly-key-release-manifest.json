  ],
  "sharedDataOwnership": {
    "bible": "account-6",
    "community": "account-3",
    "broadcastMedia": "account-2",
    "orchestration": "account-4"
  },
  "automaticContentPropagation": [
    {
      "origin": "bible",
      "consumers": [
        "app",
        "community"
      ],
      "type": "published-approved-bible-content"
    },
    {
      "origin": "community",
      "consumers": [
        "app"
      ],
      "type": "public-approved-community-content"
    },
    {
      "origin": "app",
      "consumers": [
        "community"
      ],
      "type": "approved-shared-feature-manifest-only"
    }
  ],
  "prohibitedSync": [
    "passwords",
    "user-profiles",
    "sessions",
    "private-messages",
    "private-prayer-requests",
    "database-copies",
    "production-secrets"
  ],
  "releaseGates": [
    "production-secrets-and-resources-verified",
    "staging-migrations-tested",
    "builds-and-tests-pass",
    "cross-service-contracts-tested",
    "rollback-and-backups-verified",
    "owner-production-approval"
