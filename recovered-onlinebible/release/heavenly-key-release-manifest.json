    },
    {
      "account": 2,
      "key": "studio",
      "name": "Studio, Radio, TV and Media",
      "source": null,
      "readiness": "source-and-cloudflare-verification-required"
    },
    {
      "account": 3,
      "key": "community",
      "name": "Global Christian Community",
      "source": "aoemeta247-cell/All-Nations-For-Christ-Outreach",
      "sourcePath": "global-community",
      "readiness": "cloudflare-resource-placeholders"
    },
    {
      "account": 4,
      "key": "control",
      "name": "Main Control Room",
      "source": null,
      "readiness": "independent-deployment-verification-required"
    },
    {
      "account": 5,
      "key": "app",
      "name": "Heavenly Key App",
      "source": "aoemeta247-cell/heavenly-key-mobile-app",
      "readiness": "remote-build-and-integration-tests-required"
    },
    {
      "account": 6,
      "key": "bible",
      "name": "Heavenly Key Bible",
      "source": null,
      "readiness": "separate-deployment-unverified-audio-unpublished"
