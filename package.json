    "test:cms-browser": "node tests/cms-browser.mjs",
    "test:meetings": "npm test --prefix heavenly-key-accounts/account-08-heavenly-key-meetingspace/source",
    "build:meetings": "npm run bundle:control-room --prefix heavenly-key-accounts/account-08-heavenly-key-meetingspace/source",
