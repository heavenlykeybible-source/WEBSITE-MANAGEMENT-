# Local/CI documentation only. Production secrets must be set with `wrangler secret put`.
SESSION_SECRET=
PASSWORD_PEPPER=
ENCRYPTION_KEY=

MEDIA_ENGINE_URL=https://REPLACE_WITH_MEDIA_ENGINE_HOST
MEDIA_ENGINE_SHARED_SECRET=REPLACE_WITH_SHARED_SECRET

# AI provider gateway. Keep every API key server-side and install production values
# as Cloudflare secrets. Providers with no configured key must remain disabled.
AI_DEFAULT_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=

# External AI/agent connector security.
# Generate strong independent production values; never reuse SESSION_SECRET.
AI_CONNECTOR_SIGNING_SECRET=
AI_CONNECTOR_TOKEN_PEPPER=
AI_CONNECTOR_ISSUER=https://REPLACE_WITH_HEAVENLY_KEY_HOST
