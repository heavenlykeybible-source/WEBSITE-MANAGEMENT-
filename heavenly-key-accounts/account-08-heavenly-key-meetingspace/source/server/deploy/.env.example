# Copy to .env on the existing relay host; no real secrets belong in this file.
RELAY_HOST=stream.example.com
MEETINGSPACE_ORIGIN=https://meeting.heavenlykey.org
# Absolute path on the relay host; use the same existing secret as the app's RELAY_SECRET.
RELAY_SECRET_PATH=/private/meetingspace-relay-secret.txt
MAX_SESSIONS=1
FALLBACK_MAX_MINUTES=5
