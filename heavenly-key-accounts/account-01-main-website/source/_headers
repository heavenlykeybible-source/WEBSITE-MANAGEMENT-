# _headers
# Cloudflare Pages security headers configuration.
# CSP directives below are built from an actual audit of every external
# origin this site loads from (grep across all HTML/CSS/JS/manifest —
# see FINAL-INDEPENDENT-AUDIT.md), not a generic template. Nothing here
# should be loosened without re-running that audit; nothing here should
# be tightened without checking it against the same list first.
#
# Known, deliberate tradeoff: style-src includes 'unsafe-inline'
# because this codebase uses inline style="" attributes extensively
# throughout (a documented, consistent pattern — see
# COMPONENT-LIBRARY.md). Removing every inline style to allow a
# stricter CSP would be a redesign, which is explicitly out of scope
# for this fix pass. Tracked as a known limitation, not hidden.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' blob: https://i.ytimg.com https://placehold.co https://heavenlykey-cms-public.emmanuel2026miracle.workers.dev https://api.qrserver.com; connect-src 'self' https: wss:; media-src 'self' blob: https:; worker-src 'self'; form-action 'self' https://heavenlykey.alldaywow247.workers.dev; frame-ancestors 'none'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'

# Long-lived, safe to cache aggressively — every reference is
# version-stamped with ?v=1.2.2, so a new release gets a new URL and
# never collides with a stale cached copy.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate every time so visitors always get the latest
# content/markup, not a stale cached page.
/*.html
  Cache-Control: public, max-age=0, must-revalidate


/pages/admin*
  Cache-Control: no-store
  Permissions-Policy: geolocation=(), microphone=(self), camera=(self), payment=(), usb=()
/pages/community*
  Cache-Control: no-store

