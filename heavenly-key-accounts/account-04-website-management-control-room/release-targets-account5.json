{
  "version": 1,
  "account": "Account 5",
  "releasePolicy": "manual-owner-approved",
  "defaultAction": "verify",
  "targets": [
    {
      "id": "all-in-one",
      "label": "Full All-in-One App",
      "mode": "worker",
      "workflow": "deploy-account5-app.yml",
      "sharedWorker": true,
      "scope": "complete Worker and asset bundle"
    },
    {
      "id": "premium-page",
      "label": "Premium App Showcase Page",
      "mode": "isolated-pages",
      "project": "heavenly-key-app-showcase",
      "workflow": "release-account5-component.yml",
      "scope": "homepage and static visual assets only",
      "note": "Dedicated Pages URL; production root routing requires separate approved domain configuration"
    },
    {
      "id": "guide-android",
      "label": "android installation guide",
      "mode": "isolated-pages",
      "project": "heavenly-key-guide-android",
      "workflow": "release-account5-component.yml",
      "scope": "single installation guide only"
    },
    {
      "id": "guide-iphone",
      "label": "iphone installation guide",
      "mode": "isolated-pages",
      "project": "heavenly-key-guide-iphone",
      "workflow": "release-account5-component.yml",
      "scope": "single installation guide only"
    },
    {
      "id": "guide-ipad",
      "label": "ipad installation guide",
      "mode": "isolated-pages",
      "project": "heavenly-key-guide-ipad",
      "workflow": "release-account5-component.yml",
      "scope": "single installation guide only"
    },
    {
      "id": "guide-windows",
      "label": "windows installation guide",
      "mode": "isolated-pages",
      "project": "heavenly-key-guide-windows",
      "workflow": "release-account5-component.yml",
      "scope": "single installation guide only"
    },
    {
      "id": "guide-mac",
      "label": "mac installation guide",
      "mode": "isolated-pages",
      "project": "heavenly-key-guide-mac",
      "workflow": "release-account5-component.yml",
      "scope": "single installation guide only"
    }
  ],
  "linkedApplications": [
    {
      "id": "radio",
      "owner": "separate radio application",
      "status": "not configured for isolated deployment"
    },
    {
      "id": "walk",
      "owner": "separate Walk With God application",
      "status": "not configured for isolated deployment"
    },
    {
      "id": "study",
      "owner": "separate Bible Study application",
      "status": "not configured for isolated deployment"
    },
    {
      "id": "community",
      "owner": "Account 3",
      "status": "must use its own workflow"
    },
    {
      "id": "bible",
      "owner": "Bible application",
      "status": "not configured for isolated deployment"
    }
  ],
  "safeguards": [
    "Never overwrite full app from page-only publish",
    "Never infer page-only publish updates the main Worker URL",
    "Require approval and checks per target",
    "Never deploy another account using Account 5 credentials"
  ]
}
